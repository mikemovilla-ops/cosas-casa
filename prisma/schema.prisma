// Esquema de "Nuestra Casa": lista de la compra + lista de cosas para casa
// Modelos de NextAuth (User, Account, Session, VerificationToken) + Item

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Controla si le aparecen las pestañas personales de Tareas y Deudas —
  // no afecta a qué datos ve (esos siempre están filtrados por quién los
  // creó), solo a si la pestaña se muestra.
  tareasDeudasActivado Boolean @default(false)

  accounts       Account[]
  sessions       Session[]
  itemsCreados   Item[] @relation("CreadoPor")
  itemsAsignados Item[] @relation("AsignadoA")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Tipo de lista al que pertenece el item. COMPRA y CASA son compartidas
// entre los dos usuarios; TAREA y DEUDA son personales (solo las ve quien
// las creó, ver app/api/items).
enum TipoLista {
  COMPRA
  CASA
  TAREA
  DEUDA
}

// Estado del item dentro de su lista. Para COMPRA solo se usan
// A_COMPRAR/COMPRADO; para CASA URGENTE/MEDIO/LARGO/COMPRADO; para TAREA y
// DEUDA, PENDIENTE/HECHO ("hecho" = tarea completada o deuda saldada). No se
// modela como enums separados porque un único campo `estado` simplifica el
// toggle genérico en la API; la validación de qué valores son válidos según
// el `tipo` vive en lib/items.ts.
enum EstadoItem {
  A_COMPRAR
  COMPRADO
  URGENTE
  MEDIO
  LARGO
  PENDIENTE
  HECHO
}

model Item {
  id        String     @id @default(cuid())
  tipo      TipoLista
  estado    EstadoItem
  texto     String
  cantidad  Int        @default(1)
  // Enlace a la tienda donde se compra, solo se usa en items de CASA.
  enlace    String?
  // Solo para DEUDA: importe en euros y de qué dirección es la deuda.
  importe   Float?
  meDeben   Boolean?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  creadoPorId String?
  creadoPor   User?   @relation("CreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  // A quién corresponde el item ("Los dos" = null). Independiente de quién
  // lo creó: uno puede añadir algo y asignárselo al otro. No se usa en
  // TAREA/DEUDA (son personales, no compartidas).
  asignadoAId String?
  asignadoA   User?   @relation("AsignadoA", fields: [asignadoAId], references: [id], onDelete: SetNull)

  @@index([tipo, estado])
  @@map("items")
}
